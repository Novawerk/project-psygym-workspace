---
// One layout for every page: zinc colours, system fonts, nothing loaded from another host.
import "../styles/global.css";
import { other, strings, type Locale } from "../lib/i18n";

interface Props {
  lang: Locale;
  /** The path without the language prefix, e.g. "/privacy" ("" for home). */
  path: string;
  title: string;
  description?: string;
  noindex?: boolean;
}
const { lang, path, title, description, noindex = false } = Astro.props;
const t = strings[lang];
const alt = other(lang);
const href = (l: Locale, p = path) => `/${l}${p}`;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang="zh" href={new URL(href("zh"), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(href("en"), Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="min-h-dvh bg-white font-sans text-zinc-950 antialiased">
    <header class="border-b border-zinc-200">
      <nav class="mx-auto flex max-w-3xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-4 text-sm">
        <a href={href(lang, "")} class="mr-auto font-semibold">{t.siteName}</a>
        <a href={href(lang, "/privacy")} class="text-zinc-600 hover:text-zinc-950">{t.privacy}</a>
        <a href={href(lang, "/delete-account")} class="text-zinc-600 hover:text-zinc-950">{t.deleteAccount}</a>
        <a href={href(alt)} hreflang={alt} lang={strings[alt].htmlLang} class="rounded-lg bg-zinc-100 px-3 py-1 text-zinc-700 hover:bg-zinc-200">{t.otherLanguage}</a>
      </nav>
    </header>
    <main class="mx-auto max-w-3xl px-4 py-10">
      <slot />
    </main>
    <footer class="border-t border-zinc-200">
      <p class="mx-auto max-w-3xl px-4 py-6 text-sm text-zinc-500">{t.footer}</p>
    </footer>
  </body>
</html>
