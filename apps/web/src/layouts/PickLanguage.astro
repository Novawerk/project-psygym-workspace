---
// A bare path ("/", "/privacy", "/delete-account"): send the browser to the language it picked
// before (one localStorage key, set by the 中 | EN switch), else the first of its languages we
// have, else Chinese (docs/product/landing.md). No cookie. Without JavaScript, two plain links.
interface Props {
  /** The path without the language prefix, e.g. "/privacy" ("" for home). */
  path: string;
}
const { path } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>聆镜 PSYGYM</title>
    <link rel="alternate" hreflang="zh-CN" href={new URL(`/zh${path}`, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(`/en${path}`, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(path || "/", Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline define:vars={{ path }}>
      var lang = null;
      try { lang = localStorage.getItem("lang"); } catch (e) {}
      if (lang !== "zh" && lang !== "en") {
        lang = "zh";
        var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ""];
        for (var i = 0; i < langs.length; i++) {
          var l = String(langs[i]).toLowerCase();
          if (l.indexOf("zh") === 0) { lang = "zh"; break; }
          if (l.indexOf("en") === 0) { lang = "en"; break; }
        }
      }
      location.replace("/" + lang + path + location.search + location.hash);
    </script>
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 2rem; color: #09090b">
    <p><a href={`/zh${path}`} lang="zh-CN">中文</a> · <a href={`/en${path}`} lang="en">English</a></p>
  </body>
</html>
