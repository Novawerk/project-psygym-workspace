---
// Rendered from docs/release/privacy-policy.md at build time: one source for the app, the stores
// and this page (docs/product/landing.md §3).
import Base from "../../layouts/Base.astro";
import { LOCALES, strings, type Locale } from "../../lib/i18n";
import { policyHtml, policyMeta } from "../../lib/privacy";

export const getStaticPaths = () => LOCALES.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Locale;
const t = strings[lang];
const meta = policyMeta(lang);
---

<Base lang={lang} path="/privacy" title={`${t.privacy.title} · ${t.siteName}`}>
  <div class="max-w-[760px] pt-8 pb-16 md:pt-14">
    <h1 class="text-[32px] leading-tight font-bold md:text-[44px]">{t.privacy.title}</h1>
    {meta.line && <p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400">{meta.line}</p>}
    {meta.draft && <p class="mt-4 rounded-xl bg-zinc-100 px-4 py-3 text-sm text-zinc-700 dark:bg-zinc-900 dark:text-zinc-300">{t.privacy.draft}</p>}
    <article class="policy mt-4" set:html={policyHtml(lang)} />
  </div>
</Base>
