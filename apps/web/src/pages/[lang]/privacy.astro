---
// Rendered from docs/release/privacy-policy.md at build time: one source for the app, the stores
// and this page.
import Base from "../../layouts/Base.astro";
import { LOCALES, strings, type Locale } from "../../lib/i18n";
import { policyHtml } from "../../lib/privacy";

export const getStaticPaths = () => LOCALES.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Locale;
const t = strings[lang];
const html = policyHtml(lang);
---

<Base lang={lang} path="/privacy" title={`${t.privacy} · ${t.siteName}`}>
  <h1 class="text-3xl font-semibold tracking-tight">{t.privacy}</h1>
  <article class="policy mt-6" set:html={html} />
</Base>
