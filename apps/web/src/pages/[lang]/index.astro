---
// Placeholder until the product's landing.md and the design are confirmed. Not indexed yet.
import Base from "../../layouts/Base.astro";
import { LOCALES, strings, type Locale } from "../../lib/i18n";

export const getStaticPaths = () => LOCALES.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Locale;
const t = strings[lang];
---

<Base lang={lang} path="" title={t.siteName} description={t.tagline} noindex>
  <h1 class="text-3xl font-semibold tracking-tight">{t.siteName}</h1>
  <p class="mt-3 text-lg text-zinc-600">{t.tagline}</p>
  <p class="mt-8 rounded-xl bg-zinc-100 p-4 text-sm text-zinc-600">{t.comingSoon}</p>
</Base>
