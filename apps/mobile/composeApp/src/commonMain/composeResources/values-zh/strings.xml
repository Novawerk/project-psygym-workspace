    <string name="privacy_title">隐私说明</string>
    <string name="privacy_vendor">DeepSeek</string>
    <string name="privacy_q_where">对话去了哪里？</string>
    <string name="privacy_a_where">你发的每一句，连同之前的对话，发到我们的服务器，再转给第三方 AI 模型服务生成回复。目前用的是 %1$s。</string>
    <string name="privacy_q_store">你们存吗？</string>
    <string name="privacy_a_store">我们的服务器不保存对话，也不在日志里记录对话内容。</string>
    <string name="privacy_q_vendor">AI 模型服务存吗？</string>
    <string name="privacy_a_vendor">按它们自己的政策处理。</string>
    <string name="privacy_q_device">手机上存吗？</string>
    <string name="privacy_a_device">存。每场练习的对话和报告存在这台手机上 App 自己的空间里，不上传、不进云备份。记录未加密，保存在 App 自己的存储空间里。可以在「我的」里关掉保存或全部删除，也可以在练习记录里删除单场。卸载 App 就全部删除。</string>
    <string name="privacy_q_collect">你们收集什么？</string>
    <string name="privacy_a_collect">邀请码（用来连服务器）和你选的语言，只存在这台手机上。没有账号，不收集姓名、手机号、位置。</string>
    <string name="privacy_q_real">我能输入真实来访者的信息吗？</string>
    <string name="privacy_a_real">不能。请只把它当练习。</string>

