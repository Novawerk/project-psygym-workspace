    <!-- Privacy (P3) -->
    <string name="privacy_title">Privacy</string>
    <string name="privacy_vendor">DeepSeek</string>
    <string name="privacy_q_where">Where does the conversation go?</string>
    <string name="privacy_a_where">Each message, with the conversation so far, goes to our server and on to a third-party AI model service that writes the reply. We currently use %1$s.</string>
    <string name="privacy_q_store">Do you store it?</string>
    <string name="privacy_a_store">Our servers don’t store the conversation or log its text.</string>
    <string name="privacy_q_vendor">Does the AI model service store it?</string>
    <string name="privacy_a_vendor">It follows its own policy.</string>
    <string name="privacy_q_device">Is it stored on my phone?</string>
    <string name="privacy_a_device">Yes. Each session and its report are saved in the app’s own space on this phone. Nothing is uploaded or backed up to the cloud. Records are stored unencrypted in the app’s private storage. Turn saving off or delete everything under Me; delete a single session from your practice history. Uninstalling the app deletes everything.</string>
    <string name="privacy_q_collect">What do you collect?</string>
    <string name="privacy_a_collect">Your invite code (to reach our server) and your language, kept on this phone only. No account. We don’t collect your name, phone number or location.</string>
    <string name="privacy_q_real">Can I enter real client information?</string>
    <string name="privacy_a_real">No. Please use it for practice only.</string>

