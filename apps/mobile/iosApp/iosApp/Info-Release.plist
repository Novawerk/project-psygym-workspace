<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Release: HTTPS only. Debug uses Info.plist, which also allows local networking. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Hold to talk (ADR 0010): recognised on the device, never uploaded. Translations in *.lproj/InfoPlist.strings. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>To hear you while you hold to talk. Your voice is turned into text on this phone and never uploaded.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>To turn what you say into text on this phone, offline.</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
</dict>
</plist>
