# Copy to apps/api/.env for local runs. Never commit real keys.
# The demo runs on DeepSeek. Use LLM_PROVIDER=mock to run with no key at all.

# ── Model (shared by the AI client and the AI supervisor) ──
LLM_PROVIDER=deepseek
LLM_MODEL=
LLM_BASE_URL=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
LLM_MAX_OUTPUT_TOKENS=
ANTHROPIC_EFFORT=
# off for a voice model: thinking delays the first word past what ElevenLabs waits for.
ANTHROPIC_THINKING=

# ── Optional: a different model per role (e.g. supervisor on Claude) ──
CLIENT_LLM_PROVIDER=
CLIENT_LLM_MODEL=
CLIENT_LLM_BASE_URL=
SUPERVISOR_LLM_PROVIDER=
SUPERVISOR_LLM_MODEL=
SUPERVISOR_LLM_BASE_URL=

# ── Access ──
INVITE_CODES=
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_SEC=

# ── AI client ──
# "on": the AI client ends a session only if an independent check (the supervisor model) finds
# 2 harmful counselor messages. Default off: the stream is exactly as before.
END_SESSION_JUDGE=

# ── Report feedback and reports (POST /feedback, POST /report) ──
# A Slack incoming webhook (https). Unset: feedback is dropped with a log line.
FEEDBACK_SLACK_WEBHOOK_URL=

# ── Anonymous counts (docs/decisions/0007-anonymous-counts.md) ──
# Both are needed to count; leave METRICS_ENABLED empty to keep it off.
METRICS_ENABLED=
DATABASE_URL=
# Bearer token for GET /admin/stats. Empty: the endpoint answers 404.
ADMIN_STATS_TOKEN=

# ── Voice sessions (docs/decisions/0013-voice-elevenlabs.md) ── off unless all three are set
# The key stays on the server. VOICE_LLM_SECRET (32+ characters) is what you paste into the
# agent's custom-LLM API key secret in ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
VOICE_LLM_SECRET=

# ── Sign-in (docs/decisions/0008-sign-in.md) ── off unless AUTH_MODE=on
AUTH_MODE=
AUTH_REQUIRED_FROM=
AUTH_SECRET=
METRICS_ID_SECRET=
RESEND_API_KEY=
REVIEW_LOGIN_EMAIL=
REVIEW_LOGIN_CODE=
ADMIN_TOKEN=

# ── Admin (docs/decisions/0009-admin-phase1.md) ── off unless ADMIN_MODE=on
ADMIN_MODE=
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_ORIGIN=
# "db": the app reads the published versions. Default: the bundled content/.
CONTENT_SOURCE=
CONTENT_SLACK_WEBHOOK_URL=

PORT=8787
