# Copy to .env.local. Nothing here is secret: Vite bakes VITE_* into the public bundle.

# The PSYGYM API. Local: apps/api on 8787.
VITE_API_URL=http://localhost:8787
# Google sign-in (OAuth client ID, public).
VITE_GOOGLE_CLIENT_ID=
# Fictional in-memory data and no sign-in. On until the API contract lands.
VITE_USE_SAMPLE_DATA=true
