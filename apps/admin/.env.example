# Copy to .env.local. Nothing here is secret: Vite bakes VITE_* into the public bundle.

# Google sign-in: the admin OAuth client ID (public). Allowed origins include localhost:5180.
VITE_GOOGLE_CLIENT_ID=364041827824-r7h7i79ogc1ammule012tt54h8clh4lr.apps.googleusercontent.com
# true (the default): an in-memory sample store, no sign-in. false: call apps/api through /api
# (proxied to localhost:8787; apps/api needs ADMIN_MODE=on and ADMIN_ORIGIN=http://localhost:5180).
VITE_USE_SAMPLE_DATA=true
